# ── Archery.Services environment ──
# Copy to .env (local) and set the same vars in Vercel → Project → Settings → Environment Variables.

# Supabase Postgres connection string.
# Supabase → Project Settings → Database → Connection string → URI.
# IMPORTANT for serverless: use the POOLED "Transaction" connection (host ...pooler.supabase.com, port 6543).
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Razorpay → Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx
# Same key id, exposed to the browser checkout (safe — it's the publishable id)
PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Admin panel password (protects all admin write APIs)
ADMIN_PASSWORD=set-a-strong-password

# REQUIRED — session token signing secrets. Each MUST be a long random
# string (e.g. `openssl rand -base64 48`), unique per environment, and
# DIFFERENT from ADMIN_PASSWORD and from each other. If either is left unset,
# api/_lib/auth.js and api/_lib/userauth.js now refuse to mint OR verify any
# token at all (fail closed) — so a missing value means nobody can sign in,
# not that anyone can forge a session. Set these before first deploy.
SESSION_SECRET=
USER_TOKEN_SECRET=

# OPTIONAL — enables the live AI Coach (Claude). Without it, the coach page
# still works using its built-in archery knowledge base.
# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
